{
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/auth/**/*", "src/index.ts", "lib/**/*", "build-tests/**/*"],
  "exclude": ["node_modules", "dist", "src/generator/**/*"]
}
