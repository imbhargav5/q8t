{
  "name": "@q8t/dropbox-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Dropbox API SDK with code generation from OpenAPI definitions - supports both Core and Team APIs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "tsx src/generator/index.ts",
    "build": "pnpm generate && tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "dropbox",
    "dropbox-api",
    "sdk",
    "oauth2",
    "file-storage",
    "cloud-storage",
    "team-api"
  ]
}
