    "@q8t/effect-sdk-base": "workspace:*",
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
