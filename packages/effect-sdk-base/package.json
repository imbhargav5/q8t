{
  "name": "@q8t/effect-sdk-base",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Effect-based infrastructure for Q8T SDKs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
