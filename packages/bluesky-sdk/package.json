{
  "name": "@q8t/bluesky-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Bluesky API SDK with code generation from YAML definitions",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "tsx src/generator/index.ts",
    "build": "pnpm generate && tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2"
  }
}
