{
  "name": "@q8t/telegram-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Comprehensive Telegram SDK supporting Bot API, Client API (MTProto), and Gateway API with code generation",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "tsx src/generator/index.ts",
    "build": "pnpm generate && tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "@q8t/effect-sdk-base": "workspace:*",
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
